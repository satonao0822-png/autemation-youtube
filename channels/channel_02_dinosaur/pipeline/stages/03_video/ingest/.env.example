# .env.example — material-ingest skill 環境変数テンプレ
# 実物は .env として保存（.gitignore 除外済み）

# Anthropic API（Claude Vision Sonnet 4.6）
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth クライアント（GCP Console で作成した credentials.json のパス）
GOOGLE_OAUTH_CLIENT_SECRET_PATH=/Users/satonao/.config/dino-ch/credentials.json

# OAuth トークン保存先（初回 npm run auth で生成される）
GOOGLE_OAUTH_TOKEN_PATH=/Users/satonao/.config/dino-ch/token.json

# Drive ルートフォルダID（storage.yml と同じ・恐竜チャンネル）
DRIVE_ROOT_FOLDER_ID=1PRy9c_Qm5_f4Hc7k1eTushVWLk420De5

# 月予算上限（円）
MONTHLY_BUDGET_YEN=1000

# 動作モード（production / dry_run）
INGEST_MODE=production
